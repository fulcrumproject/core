  "name": "svc-subnet-cooldown {{$guid}}",
  "propertySchema": {
    "properties": {
      "ip": {
        "type": "string",
        "label": "IP",
        "immutable": true,
        "authorizers": [ {"type": "actor", "config": {"actors": ["system"]}} ],
        "generator": { "type": "pool", "config": {"poolType": "svc_subnet_cooldown"} }
      }
    }
  },
  "lifecycleSchema": {
    "states": [
      {"name": "creating"},
      {"name": "created"},
      {"name": "creationFailed"},
      {"name": "deleted"}
    ],
    "actions": [
      {
        "name": "create",
        "transitions": [
          {"from": "creating", "to": "created"},
          {"from": "creating", "to": "creationFailed", "onError": true}
        ]
      },
      {
        "name": "delete",
        "transitions": [ {"from": "created", "to": "deleted"} ]
      }
    ],
    "initialState": "creating",
    "terminateState": "deleted",
    "terminalStates": ["deleted", "creationFailed"]
  }
}

@cooldownServiceTypeId = {{createCooldownServiceType.response.body.id}}

