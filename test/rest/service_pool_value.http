### Service Pool Value reuse flows (subnet generator)
###
### Exercises the new reuse behaviour end to end through service create + release:
###   - Scenario A: with no retentionSeconds a freed IP is reused immediately.
###   - Scenario B: a retentionSeconds cooldown holds a freed IP until it elapses.
###   - Scenario C: neverReallocate retires a freed IP forever (never reused).
###
### Release is triggered by failing a create job into a terminal state, which runs
### ServicePoolValueRepository.ReleaseByService (clears serviceId, stamps releasedAt).

### Variables
@baseUrl = http://localhost:3000/api/v1
@adminToken = change-me

###############################################################################
### SHARED SETUP
###############################################################################

### Provider
# @name createProvider
POST {{baseUrl}}/participants
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Service Pool Reuse Provider {{$guid}}",
  "status": "Enabled"
}

@providerId = {{createProvider.response.body.id}}

### Service Pool Set
# @name createPoolSet
POST {{baseUrl}}/service-pool-sets
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Service Pool Reuse Set {{$guid}}",
  "providerId": "{{providerId}}"
}

@poolSetId = {{createPoolSet.response.body.id}}

### Reuse pool: subnet 10.50.0.0/31 (usable .0, .1), no retention -> immediate reuse
# @name createReusePool
POST {{baseUrl}}/service-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Reuse Pool",
  "type": "svc_subnet_reuse",
  "propertyType": "string",
  "generatorType": "subnet",
  "generatorConfig": { "cidr": "10.50.0.0/31" },
  "servicePoolSetId": "{{poolSetId}}"
}

### Cooldown pool: subnet 10.60.0.0/31 (usable .0, .1) with a 30s reuse cooldown
# @name createCooldownPool
POST {{baseUrl}}/service-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Cooldown Pool",
  "type": "svc_subnet_cooldown",
  "propertyType": "string",
  "generatorType": "subnet",
  "generatorConfig": { "cidr": "10.60.0.0/31", "retentionSeconds": 30 },
  "servicePoolSetId": "{{poolSetId}}"
}

### Never pool: subnet 10.80.0.0/31 (usable .0, .1), neverReallocate -> freed IP retired
# @name createNeverPool
POST {{baseUrl}}/service-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Never Reallocate Pool",
  "type": "svc_subnet_never",
  "propertyType": "string",
  "generatorType": "subnet",
  "generatorConfig": { "cidr": "10.80.0.0/31", "neverReallocate": true },
  "servicePoolSetId": "{{poolSetId}}"
}

### Service Type (reuse): create has OnError -> creationFailed (terminal) so a failed
### create releases the allocated IP.
# @name createReuseServiceType
POST {{baseUrl}}/service-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "svc-subnet-reuse {{$guid}}",
  "propertySchema": {
    "properties": {
      "ip": {
        "type": "string",
        "label": "IP",
        "immutable": true,
        "authorizers": [ {"type": "actor", "config": {"actors": ["system"]}} ],
        "generator": { "type": "pool", "config": {"poolType": "svc_subnet_reuse"} }
      }
    }
  },
  "lifecycleSchema": {
    "states": [
      {"name": "creating"},
      {"name": "created"},
      {"name": "creationFailed"},
      {"name": "deleted"}
    ],
    "actions": [
      {
        "name": "create",
        "transitions": [
          {"from": "creating", "to": "created"},
          {"from": "creating", "to": "creationFailed", "onError": true}
        ]
      },
      {
        "name": "delete",
        "transitions": [ {"from": "created", "to": "deleted"} ]
      }
    ],
    "initialState": "creating",
    "terminateState": "deleted",
    "terminalStates": ["deleted", "creationFailed"]
  }
}

@reuseServiceTypeId = {{createReuseServiceType.response.body.id}}

### Service Type (cooldown): same lifecycle, allocates from the cooldown pool
# @name createCooldownServiceType
POST {{baseUrl}}/service-types
