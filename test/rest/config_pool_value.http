### Config Pool Value Operations
### This file tests operations for config pool values

### Variables
@baseUrl = http://localhost:3000/api/v1
@adminToken = change-me

### Create an config pool (needed for config pool values)
# @name createConfigPool
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Test Pool",
  "type": "publicIp",
  "propertyType": "string",
  "generatorType": "list"
}

@configPoolId = {{createConfigPool.response.body.$.id}}

### Get all config pool values
GET {{baseUrl}}/config-pool-values
Authorization: Bearer {{adminToken}}

### Get all config pool values with filter by name
GET {{baseUrl}}/config-pool-values?name=192
Authorization: Bearer {{adminToken}}

### Get all config pool values with filter by configPoolId
GET {{baseUrl}}/config-pool-values?configPoolId={{configPoolId}}
Authorization: Bearer {{adminToken}}

### Get all config pool values with filter by agentId
GET {{baseUrl}}/config-pool-values?agentId=change-me
Authorization: Bearer {{adminToken}}

### Get all config pool values with filter by infrastructureId
GET {{baseUrl}}/config-pool-values?infrastructureId=change-me
Authorization: Bearer {{adminToken}}

### Create an config pool value
# @name createConfigPoolValue
POST {{baseUrl}}/config-pool-values
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "192.168.1.10",
  "value": "192.168.1.10",
  "configPoolId": "{{configPoolId}}"
}

@configPoolValueId = {{createConfigPoolValue.response.body.$.id}}

### Get a specific config pool value
GET {{baseUrl}}/config-pool-values/{{configPoolValueId}}
Authorization: Bearer {{adminToken}}

###############################################################################
### Auth: global pool (admin-only) vs participant-scoped pool
###############################################################################
### Verifies the recent auth work:
###   - List filter applier hides other-scope rows from a participant.
###   - AuthScope returns AdminOnlyObjectScope for global pool values (403).
###   - AuthScope returns the owning DefaultObjectScope for scoped values (200).

### Create a participant that will own the scoped pool
# @name createScopedParticipant
POST {{baseUrl}}/participants
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Config Pool Participant",
  "status": "Enabled"
}

@scopedParticipantId = {{createScopedParticipant.response.body.$.id}}

### Issue a participant-scoped token
# @name createScopedParticipantToken
POST {{baseUrl}}/tokens
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Scoped Participant Token",
  "role": "participant",
  "expireAt": "{{$datetime iso8601 1 y}}",
  "scopeId": "{{scopedParticipantId}}"
}

@participantToken = {{createScopedParticipantToken.response.body.value}}

### Create a participant-scoped pool (participantId set => non-global)
# @name createScopedPool
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Participant Pool",
  "type": "scopedIp",
  "propertyType": "string",
  "generatorType": "list",
  "participantId": "{{scopedParticipantId}}"
}

@scopedPoolId = {{createScopedPool.response.body.$.id}}

### Seed a value in the scoped pool
# @name createScopedValue
POST {{baseUrl}}/config-pool-values
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "10.0.0.1",
  "value": "10.0.0.1",
  "configPoolId": "{{scopedPoolId}}"
}

@scopedValueId = {{createScopedValue.response.body.$.id}}

### Participant LIST — expect only the scoped value; global value filtered out
GET {{baseUrl}}/config-pool-values
Authorization: Bearer {{participantToken}}

###  Participant GET on the global value — expect 403 (AdminOnlyObjectScope)
GET {{baseUrl}}/config-pool-values/{{configPoolValueId}}
Authorization: Bearer {{participantToken}}

###  Participant GET on their own scoped value — expect 200
GET {{baseUrl}}/config-pool-values/{{scopedValueId}}
Authorization: Bearer {{participantToken}}

### Delete an config pool value
DELETE {{baseUrl}}/config-pool-values/{{configPoolValueId}}
Authorization: Bearer {{adminToken}}

###############################################################################
### Pool generator end-to-end: allocation on agent Create, release on Delete
###############################################################################
### This walks through the `generator: "pool"` flow end-to-end:
###   1. Seed a pool and two values.
###   2. Declare an agent type whose configurationSchema has a pool-generated
###      property.
###   3. Create an agent → observe that the property gets auto-allocated.
###   4. Create a second agent → uses the second value.
###   5. Create a third agent → fails with "no available values in pool".
###   6. Delete the first agent → its value gets released.
###   7. Create a third agent → now succeeds using the released value.

### Create a provider for the pool-generator scenario
# @name createPoolGenProvider
POST {{baseUrl}}/participants
Authorization: Bearer {{adminToken}}

{
  "name": "Pool Generator Provider",
  "status": "Enabled"
}

@poolGenProviderId = {{createPoolGenProvider.response.body.$.id}}

### Create a pool dedicated to this scenario
# @name createPoolGenPool
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Pool Generator Pool",
  "type": "publicIpGen",
  "propertyType": "string",
  "generatorType": "list"
}

@poolGenPoolId = {{createPoolGenPool.response.body.$.id}}

### Seed the pool with two values
# @name createPoolGenValue1
POST {{baseUrl}}/config-pool-values
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "203.0.113.10",
  "value": "203.0.113.10",
  "configPoolId": "{{poolGenPoolId}}"
}

@poolGenValueId1 = {{createPoolGenValue1.response.body.$.id}}

### Seed the pool with two values
# @name createPoolGenValue2
POST {{baseUrl}}/config-pool-values
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "203.0.113.11",
  "value": "203.0.113.11",
  "configPoolId": "{{poolGenPoolId}}"
}

@poolGenValueId2 = {{createPoolGenValue2.response.body.$.id}}

### Create an agent type that auto-allocates publicIP from the pool
# @name createPoolGenAgentType
POST {{baseUrl}}/agent-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Pool Generator Agent Type {{$timestamp}}",
  "configurationSchema": {
    "properties": {
      "publicIP": {
        "type": "string",
        "label": "Public IP",
        "generator": {
          "type": "pool",
          "config": {
            "poolType": "publicIpGen"
          }
        }
      }
    }
  }
}

@poolGenAgentTypeId = {{createPoolGenAgentType.response.body.$.id}}

### Create first agent — expect publicIP to be auto-allocated from the pool
# @name createPoolGenAgent1
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Pool Gen Agent 1",
  "providerId": "{{poolGenProviderId}}",
  "agentTypeId": "{{poolGenAgentTypeId}}",
  "configuration": {}
}

@poolGenAgent1Id = {{createPoolGenAgent1.response.body.$.id}}

### Verify agent 1 got a pool value in its configuration
GET {{baseUrl}}/agents/{{poolGenAgent1Id}}
Authorization: Bearer {{adminToken}}

### Verify agent 1 is stamped on one of the pool values
GET {{baseUrl}}/config-pool-values?agentId={{poolGenAgent1Id}}
Authorization: Bearer {{adminToken}}

### Create second agent — takes the remaining pool value
# @name createPoolGenAgent2
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Pool Gen Agent 2",
  "providerId": "{{poolGenProviderId}}",
  "agentTypeId": "{{poolGenAgentTypeId}}",
  "configuration": {}
}

@poolGenAgent2Id = {{createPoolGenAgent2.response.body.$.id}}

### Verify agent 2 configuration is populated
GET {{baseUrl}}/agents/{{poolGenAgent2Id}}
Authorization: Bearer {{adminToken}}

### List all values in the pool — both should be allocated
GET {{baseUrl}}/config-pool-values?configPoolId={{poolGenPoolId}}
Authorization: Bearer {{adminToken}}

### TEST: third agent fails — no available values in pool
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Pool Gen Agent 3 (should fail)",
  "providerId": "{{poolGenProviderId}}",
  "agentTypeId": "{{poolGenAgentTypeId}}",
  "configuration": {}
}

### Idempotent update — re-applying schema on update does NOT reallocate
PATCH {{baseUrl}}/agents/{{poolGenAgent1Id}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Pool Gen Agent 1 (updated)"
}

### Verify agent 1 still holds its original pool value
GET {{baseUrl}}/agents/{{poolGenAgent1Id}}
Authorization: Bearer {{adminToken}}

### Delete agent 1 — expect its pool value to be released
DELETE {{baseUrl}}/agents/{{poolGenAgent1Id}}
Authorization: Bearer {{adminToken}}

### Verify agent 1's values were released (agentId filter should return empty)
GET {{baseUrl}}/config-pool-values?agentId={{poolGenAgent1Id}}
Authorization: Bearer {{adminToken}}

### List pool values — one should now be available again (agentId=null)
GET {{baseUrl}}/config-pool-values?configPoolId={{poolGenPoolId}}
Authorization: Bearer {{adminToken}}

### New agent now succeeds because the released value is available again
# @name createPoolGenAgent3
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Pool Gen Agent 3",
  "providerId": "{{poolGenProviderId}}",
  "agentTypeId": "{{poolGenAgentTypeId}}",
  "configuration": {}
}

@poolGenAgent3Id = {{createPoolGenAgent3.response.body.$.id}}

### Confirm the previously released value is now stamped on agent 3
GET {{baseUrl}}/config-pool-values?agentId={{poolGenAgent3Id}}
Authorization: Bearer {{adminToken}}

###############################################################################
### Type uniqueness across global vs participant + type-based allocation
###############################################################################
### Verifies the cross-scope uniqueness rule and that allocation is resolved by
### type alone (whichever scope owns the type, globals included):
###   1. A type cannot exist as both global and participant — admin creates a
###      global pool of type T; provider attempt to create a participant pool
###      of type T returns 400.
###   2. Symmetric direction: provider creates participant pool of type T2;
###      admin attempt to create a global of T2 returns 400.
###   3. Agent under any provider whose AgentType references type T allocates
###      from the global pool of T (T is owned by the global scope, so the
###      global pool is the pool of T — no fallback involved).

### Static type used by both a global and a participant pool to trigger the
### conflict. Avoid {{$timestamp}} in @-vars (re-evaluated per request).
@scopedGenPoolType = scopedGenIp
@scopedGenPoolType2 = scopedGenIp2

### Participant cannot create a global pool (auth, not the new rule) — expect 403
POST {{baseUrl}}/config-pools
Authorization: Bearer {{participantToken}}
Content-Type: application/json

{
  "name": "Scoped Gen Global Pool (forbidden)",
  "type": "{{scopedGenPoolType}}",
  "propertyType": "string",
  "generatorType": "list"
}

### Admin creates a global pool of type T
# @name createScopedGenGlobalPool
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Scoped Gen Global Pool",
  "type": "{{scopedGenPoolType}}",
  "propertyType": "string",
  "generatorType": "list"
}

@scopedGenGlobalPoolId = {{createScopedGenGlobalPool.response.body.$.id}}

### Seed a value in the global pool (used by the fallback agent below)
POST {{baseUrl}}/config-pool-values
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "10.10.10.10",
  "value": "10.10.10.10",
  "configPoolId": "{{scopedGenGlobalPoolId}}"
}

### Create the provider that will exercise the cross-scope cases
# @name createScopedGenProvider
POST {{baseUrl}}/participants
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Scoped Gen Provider",
  "status": "Enabled"
}

@scopedGenProviderId = {{createScopedGenProvider.response.body.$.id}}

### CONFLICT: provider attempts to create a participant pool of type T — expect
### 400 with body "...already exists in global scope"
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Scoped Gen Provider Pool (rejected)",
  "type": "{{scopedGenPoolType}}",
  "propertyType": "string",
  "generatorType": "list",
  "participantId": "{{scopedGenProviderId}}"
}

### Inverse direction: provider creates a participant pool of type T2
# @name createScopedGenProviderPool2
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Scoped Gen Provider Pool T2",
  "type": "{{scopedGenPoolType2}}",
  "propertyType": "string",
  "generatorType": "list",
  "participantId": "{{scopedGenProviderId}}"
}

@scopedGenProviderPool2Id = {{createScopedGenProviderPool2.response.body.$.id}}

### CONFLICT: admin attempts to create a global pool of type T2 — expect 400
### with body "...already exists in participant <scopedGenProviderId> scope"
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Scoped Gen Global Pool T2 (rejected)",
  "type": "{{scopedGenPoolType2}}",
  "propertyType": "string",
  "generatorType": "list"
}

### Agent type that requests a value of type T
# @name createScopedGenAgentType
POST {{baseUrl}}/agent-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Scoped Gen Agent Type {{$timestamp}}",
  "configurationSchema": {
    "properties": {
      "poolIp": {
        "type": "string",
        "label": "Pool IP",
        "generator": {
          "type": "pool",
          "config": {
            "poolType": "{{scopedGenPoolType}}"
          }
        }
      }
    }
  }
}

@scopedGenAgentTypeId = {{createScopedGenAgentType.response.body.$.id}}

### Agent under the provider — type T is owned by the global scope (the
### provider's same-type create was rejected above), so the agent allocates
### from the global pool (10.10.10.10)
# @name createScopedGenAgent
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Scoped Gen Agent (global fallback)",
  "providerId": "{{scopedGenProviderId}}",
  "agentTypeId": "{{scopedGenAgentTypeId}}",
  "configuration": {}
}

@scopedGenAgentId = {{createScopedGenAgent.response.body.$.id}}

### Inspect agent — poolIp must be 10.10.10.10 (allocated from the global pool of T)
GET {{baseUrl}}/agents/{{scopedGenAgentId}}
Authorization: Bearer {{adminToken}}

### Sanity: the global pool's value is now stamped on the agent
GET {{baseUrl}}/config-pool-values?agentId={{scopedGenAgentId}}
Authorization: Bearer {{adminToken}}

###############################################################################
### Range generator: reuse-on-release (released value IS re-allocated)
###############################################################################
### With no retentionSeconds, range/subnet now reuse a freed value immediately
### (release keeps the row, clears agentId and stamps releasedAt):
###   1. Range pool min=1, max=3.
###   2. Agent 1 -> value 1; agent 2 -> value 2.
###   3. Delete agent 1 -> value 1 row is kept with agentId=null, releasedAt set.
###   4. Agent 3 -> REUSES the freed value 1 (lowest free), not a new value.
###   5. Agent 4 -> gets value 3 (next free); agent 5 -> fails "range exhausted".

### Provider for the range scenario
# @name createRangeProvider
POST {{baseUrl}}/participants
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Generator Provider",
  "status": "Enabled"
}

@rangeProviderId = {{createRangeProvider.response.body.$.id}}

### Range pool with three values (1..3), no retention -> immediate reuse
# @name createRangePool
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Reuse Pool",
  "type": "rangeReuseAsn",
  "propertyType": "integer",
  "generatorType": "range",
  "generatorConfig": { "min": 1, "max": 3 }
}

@rangePoolId = {{createRangePool.response.body.$.id}}

### Agent type that auto-allocates a value of this type
# @name createRangeAgentType
POST {{baseUrl}}/agent-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Reuse Agent Type {{$timestamp}}",
  "configurationSchema": {
    "properties": {
      "asn": {
        "type": "integer",
        "label": "ASN",
        "generator": {
          "type": "pool",
          "config": {
            "poolType": "rangeReuseAsn"
          }
        }
      }
    }
  }
}

@rangeAgentTypeId = {{createRangeAgentType.response.body.$.id}}

### Agent 1 -> allocates value 1
# @name createRangeAgent1
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Agent 1",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{rangeAgentTypeId}}",
  "configuration": {}
}

@rangeAgent1Id = {{createRangeAgent1.response.body.$.id}}

### Verify agent 1 holds value 1
GET {{baseUrl}}/config-pool-values?agentId={{rangeAgent1Id}}
Authorization: Bearer {{adminToken}}

### Agent 2 -> allocates value 2
# @name createRangeAgent2
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Agent 2",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{rangeAgentTypeId}}",
  "configuration": {}
}

@rangeAgent2Id = {{createRangeAgent2.response.body.$.id}}

### Verify agent 2 holds value 2
GET {{baseUrl}}/config-pool-values?agentId={{rangeAgent2Id}}
Authorization: Bearer {{adminToken}}

### Delete agent 1 -> value 1 is released (row kept, agentId=null, releasedAt set)
DELETE {{baseUrl}}/agents/{{rangeAgent1Id}}
Authorization: Bearer {{adminToken}}

### Value 1's row must still exist with agentId=null and releasedAt populated
GET {{baseUrl}}/config-pool-values?configPoolId={{rangePoolId}}
Authorization: Bearer {{adminToken}}

### Agent 3 -> REUSES the freed value 1 (lowest free), not a new value
# @name createRangeAgent3
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Agent 3",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{rangeAgentTypeId}}",
  "configuration": {}
}

@rangeAgent3Id = {{createRangeAgent3.response.body.$.id}}

### Confirm agent 3 reused value 1 (releasedAt is cleared again)
GET {{baseUrl}}/config-pool-values?agentId={{rangeAgent3Id}}
Authorization: Bearer {{adminToken}}

### Agent 4 -> gets value 3 (the only remaining free value)
# @name createRangeAgent4
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Agent 4",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{rangeAgentTypeId}}",
  "configuration": {}
}

@rangeAgent4Id = {{createRangeAgent4.response.body.$.id}}

### Confirm agent 4 got value 3
GET {{baseUrl}}/config-pool-values?agentId={{rangeAgent4Id}}
Authorization: Bearer {{adminToken}}

### TEST: agent 5 fails — values 1, 2 and 3 are all in use
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Agent 5 (should fail)",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{rangeAgentTypeId}}",
  "configuration": {}
}

###############################################################################
### Range generator: retentionSeconds cooldown blocks reuse until it elapses
###############################################################################
### A positive retentionSeconds holds a freed value out of circulation until the
### cooldown elapses, measured from releasedAt:
###   1. Range pool min=1, max=3, retentionSeconds=30.
###   2. Agent 1 -> value 1; agent 2 -> value 2.
###   3. Delete agent 1 -> value 1 freed at T0 (still cooling).
###   4. Agent 3 (immediately) -> value 1 is reserved (cooling), so it mints value 3.
###   5. Agent 4 (immediately) -> fails "range exhausted" (1 cooling, 2 and 3 in use).
###   6. WAIT > 30 seconds, then agent 4 retry -> REUSES the now-cooled value 1.

### Range pool with a 30s reuse cooldown
# @name createCooldownPool
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Cooldown Pool",
  "type": "rangeCooldownAsn",
  "propertyType": "integer",
  "generatorType": "range",
  "generatorConfig": { "min": 1, "max": 3, "retentionSeconds": 30 }
}

@cooldownPoolId = {{createCooldownPool.response.body.$.id}}

### Agent type for the cooldown pool
# @name createCooldownAgentType
POST {{baseUrl}}/agent-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Cooldown Agent Type {{$timestamp}}",
  "configurationSchema": {
    "properties": {
      "asn": {
        "type": "integer",
        "label": "ASN",
        "generator": {
          "type": "pool",
          "config": {
            "poolType": "rangeCooldownAsn"
          }
        }
      }
    }
  }
}

@cooldownAgentTypeId = {{createCooldownAgentType.response.body.$.id}}

### Agent 1 -> value 1
# @name createCooldownAgent1
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Cooldown Agent 1",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{cooldownAgentTypeId}}",
  "configuration": {}
}

@cooldownAgent1Id = {{createCooldownAgent1.response.body.$.id}}

### Agent 2 -> value 2
# @name createCooldownAgent2
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Cooldown Agent 2",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{cooldownAgentTypeId}}",
  "configuration": {}
}

@cooldownAgent2Id = {{createCooldownAgent2.response.body.$.id}}

### Delete agent 1 -> value 1 freed at T0 (cooldown starts)
DELETE {{baseUrl}}/agents/{{cooldownAgent1Id}}
Authorization: Bearer {{adminToken}}

### Agent 3 (immediately) -> value 1 still cooling, so mints value 3
# @name createCooldownAgent3
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Cooldown Agent 3",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{cooldownAgentTypeId}}",
  "configuration": {}
}

@cooldownAgent3Id = {{createCooldownAgent3.response.body.$.id}}

### Confirm agent 3 got value 3 (value 1 was held by the cooldown)
GET {{baseUrl}}/config-pool-values?agentId={{cooldownAgent3Id}}
Authorization: Bearer {{adminToken}}

### TEST: agent 4 (immediately) fails — value 1 is still cooling, 2 and 3 in use
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Cooldown Agent 4 (should fail while cooling)",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{cooldownAgentTypeId}}",
  "configuration": {}
}

### WAIT > 30 seconds (the retentionSeconds cooldown) before the next request.

### Agent 4 retry -> now REUSES the cooled-down value 1
# @name createCooldownAgent4
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Cooldown Agent 4",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{cooldownAgentTypeId}}",
  "configuration": {}
}

@cooldownAgent4Id = {{createCooldownAgent4.response.body.$.id}}

### Confirm agent 4 reused value 1 after the cooldown elapsed
GET {{baseUrl}}/config-pool-values?agentId={{cooldownAgent4Id}}
Authorization: Bearer {{adminToken}}

###############################################################################
### Range generator: neverReallocate retires a freed value forever
###############################################################################
### neverReallocate=true keeps a released value out of circulation permanently,
### regardless of any retentionSeconds:
###   1. Range pool min=1, max=3, neverReallocate=true.
###   2. Agent 1 -> value 1; agent 2 -> value 2.
###   3. Delete agent 1 -> value 1 freed (row kept, agentId=null, releasedAt set).
###   4. Agent 3 -> value 1 is retired, so it mints value 3 (never reuses 1).
###   5. Agent 4 -> fails "range exhausted" (1 retired forever, 2 and 3 in use).

### Range pool that never reallocates a freed value
# @name createNeverPool
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Never Reallocate Pool",
  "type": "rangeNeverAsn",
  "propertyType": "integer",
  "generatorType": "range",
  "generatorConfig": { "min": 1, "max": 3, "neverReallocate": true }
}

@neverPoolId = {{createNeverPool.response.body.$.id}}

### Agent type for the never-reallocate pool
# @name createNeverAgentType
POST {{baseUrl}}/agent-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Range Never Agent Type {{$timestamp}}",
  "configurationSchema": {
    "properties": {
      "asn": {
        "type": "integer",
        "label": "ASN",
        "generator": {
          "type": "pool",
          "config": {
            "poolType": "rangeNeverAsn"
          }
        }
      }
    }
  }
}

@neverAgentTypeId = {{createNeverAgentType.response.body.$.id}}

### Agent 1 -> value 1
# @name createNeverAgent1
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Never Agent 1",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{neverAgentTypeId}}",
  "configuration": {}
}

@neverAgent1Id = {{createNeverAgent1.response.body.$.id}}

### Agent 2 -> value 2
# @name createNeverAgent2
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Never Agent 2",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{neverAgentTypeId}}",
  "configuration": {}
}

@neverAgent2Id = {{createNeverAgent2.response.body.$.id}}

### Delete agent 1 -> value 1 freed and retired forever
DELETE {{baseUrl}}/agents/{{neverAgent1Id}}
Authorization: Bearer {{adminToken}}

### Agent 3 -> value 1 is retired, so it mints value 3 (never reuses 1)
# @name createNeverAgent3
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Never Agent 3",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{neverAgentTypeId}}",
  "configuration": {}
}

@neverAgent3Id = {{createNeverAgent3.response.body.$.id}}

### Confirm agent 3 got value 3, not the retired value 1
GET {{baseUrl}}/config-pool-values?agentId={{neverAgent3Id}}
Authorization: Bearer {{adminToken}}

### TEST: agent 4 fails — value 1 is retired forever, 2 and 3 in use
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Never Agent 4 (should fail, 1 retired)",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{neverAgentTypeId}}",
  "configuration": {}
}

### The retired value 1 row remains with agentId=null and releasedAt set, unused
GET {{baseUrl}}/config-pool-values?configPoolId={{neverPoolId}}
Authorization: Bearer {{adminToken}}

###############################################################################
### Subnet generator: reuse-on-release (released IP IS re-allocated)
###############################################################################
### Same reuse behaviour as range, but for the subnet generator. Host mode on a
### /31 yields exactly two IPs (10.70.0.0, 10.70.0.1):
###   1. Agent 1 -> 10.70.0.0; agent 2 -> 10.70.0.1.
###   2. Delete agent 1 -> 10.70.0.0 freed (row kept, agentId=null, releasedAt set).
###   3. Agent 3 -> REUSES 10.70.0.0 (lowest free).
###   4. Agent 4 -> fails "subnet exhausted" (both IPs in use).

### Subnet pool: 10.70.0.0/31 host mode, no retention -> immediate reuse
# @name createSubnetReusePool
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Reuse Pool",
  "type": "subnetReuseIp",
  "propertyType": "string",
  "generatorType": "subnet",
  "generatorConfig": { "cidr": "10.70.0.0/31" }
}

### Agent type that auto-allocates an IP from the subnet pool
# @name createSubnetReuseAgentType
POST {{baseUrl}}/agent-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Reuse Agent Type {{$timestamp}}",
  "configurationSchema": {
    "properties": {
      "ip": {
        "type": "string",
        "label": "IP",
        "generator": { "type": "pool", "config": { "poolType": "subnetReuseIp" } }
      }
    }
  }
}

@subnetReuseAgentTypeId = {{createSubnetReuseAgentType.response.body.$.id}}

### Agent 1 -> 10.70.0.0
# @name createSubnetAgent1
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Agent 1",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{subnetReuseAgentTypeId}}",
  "configuration": {}
}

@subnetAgent1Id = {{createSubnetAgent1.response.body.$.id}}

### Verify agent 1 holds 10.70.0.0
GET {{baseUrl}}/config-pool-values?agentId={{subnetAgent1Id}}
Authorization: Bearer {{adminToken}}

### Agent 2 -> 10.70.0.1
# @name createSubnetAgent2
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Agent 2",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{subnetReuseAgentTypeId}}",
  "configuration": {}
}

@subnetAgent2Id = {{createSubnetAgent2.response.body.$.id}}

### Verify agent 2 holds 10.70.0.1
GET {{baseUrl}}/config-pool-values?agentId={{subnetAgent2Id}}
Authorization: Bearer {{adminToken}}

### Delete agent 1 -> 10.70.0.0 released (row kept, agentId=null, releasedAt set)
DELETE {{baseUrl}}/agents/{{subnetAgent1Id}}
Authorization: Bearer {{adminToken}}

### Agent 3 -> REUSES the freed 10.70.0.0
# @name createSubnetAgent3
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Agent 3",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{subnetReuseAgentTypeId}}",
  "configuration": {}
}

@subnetAgent3Id = {{createSubnetAgent3.response.body.$.id}}

### Confirm agent 3 reused 10.70.0.0 (releasedAt cleared again)
GET {{baseUrl}}/config-pool-values?agentId={{subnetAgent3Id}}
Authorization: Bearer {{adminToken}}

### TEST: agent 4 fails — both 10.70.0.0 and 10.70.0.1 are in use
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Agent 4 (should fail)",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{subnetReuseAgentTypeId}}",
  "configuration": {}
}

###############################################################################
### Subnet generator: retentionSeconds cooldown blocks reuse until it elapses
###############################################################################
### Host mode on a /30 with excludeLast=1 yields three IPs (.0, .1, .2):
###   1. Subnet pool 10.71.0.0/30, excludeLast=1, retentionSeconds=30.
###   2. Agent 1 -> 10.71.0.0; agent 2 -> 10.71.0.1.
###   3. Delete agent 1 -> 10.71.0.0 freed at T0 (still cooling).
###   4. Agent 3 (immediately) -> 10.71.0.0 reserved (cooling), so it mints 10.71.0.2.
###   5. Agent 4 (immediately) -> fails "subnet exhausted" (all three in use/cooling).
###   6. WAIT > 30 seconds, then agent 4 retry -> REUSES the now-cooled 10.71.0.0.

### Subnet pool with a 30s reuse cooldown
# @name createSubnetCooldownPool
POST {{baseUrl}}/config-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Cooldown Pool",
  "type": "subnetCooldownIp",
  "propertyType": "string",
  "generatorType": "subnet",
  "generatorConfig": { "cidr": "10.71.0.0/30", "excludeLast": 1, "retentionSeconds": 30 }
}

### Agent type for the cooldown subnet pool
# @name createSubnetCooldownAgentType
POST {{baseUrl}}/agent-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Cooldown Agent Type {{$timestamp}}",
  "configurationSchema": {
    "properties": {
      "ip": {
        "type": "string",
        "label": "IP",
        "generator": { "type": "pool", "config": { "poolType": "subnetCooldownIp" } }
      }
    }
  }
}

@subnetCooldownAgentTypeId = {{createSubnetCooldownAgentType.response.body.$.id}}

### Agent 1 -> 10.71.0.0
# @name createSubnetCdAgent1
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Cooldown Agent 1",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{subnetCooldownAgentTypeId}}",
  "configuration": {}
}

@subnetCdAgent1Id = {{createSubnetCdAgent1.response.body.$.id}}

### Agent 2 -> 10.71.0.1
# @name createSubnetCdAgent2
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Cooldown Agent 2",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{subnetCooldownAgentTypeId}}",
  "configuration": {}
}

@subnetCdAgent2Id = {{createSubnetCdAgent2.response.body.$.id}}

### Delete agent 1 -> 10.71.0.0 freed at T0 (cooldown starts)
DELETE {{baseUrl}}/agents/{{subnetCdAgent1Id}}
Authorization: Bearer {{adminToken}}

### Agent 3 (immediately) -> 10.71.0.0 still cooling, so mints 10.71.0.2
# @name createSubnetCdAgent3
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Cooldown Agent 3",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{subnetCooldownAgentTypeId}}",
  "configuration": {}
}

@subnetCdAgent3Id = {{createSubnetCdAgent3.response.body.$.id}}

### Confirm agent 3 got 10.71.0.2 (10.71.0.0 held by the cooldown)
GET {{baseUrl}}/config-pool-values?agentId={{subnetCdAgent3Id}}
Authorization: Bearer {{adminToken}}

### TEST: agent 4 (immediately) fails — 10.71.0.0 cooling, 10.71.0.1 and .2 in use
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Cooldown Agent 4 (should fail while cooling)",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{subnetCooldownAgentTypeId}}",
  "configuration": {}
}

### WAIT > 30 seconds (the retentionSeconds cooldown) before the next request.

### Agent 4 retry -> now REUSES the cooled-down 10.71.0.0
# @name createSubnetCdAgent4
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Subnet Cooldown Agent 4",
  "providerId": "{{rangeProviderId}}",
  "agentTypeId": "{{subnetCooldownAgentTypeId}}",
  "configuration": {}
}

@subnetCdAgent4Id = {{createSubnetCdAgent4.response.body.$.id}}

### Confirm agent 4 reused 10.71.0.0 after the cooldown elapsed
GET {{baseUrl}}/config-pool-values?agentId={{subnetCdAgent4Id}}
Authorization: Bearer {{adminToken}}
